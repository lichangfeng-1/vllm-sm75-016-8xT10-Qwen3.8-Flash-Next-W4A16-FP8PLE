{
 "id": "sm75-deploy-base",
 "name": "fp8/BF16 original",
 "backend": "native",
 "format": "fp8",
 "cacheRoot": "/console-data/cache",
 "port": 8000,
 "power": {
  "mode": "pstate",
  "idleSeconds": 120,
  "util": 5,
  "confirm": 60,
  "low": 8,
  "high": 16,
  "poll": 5,
  "gpus": "0,1,2,3,4,5,6,7"
 },
 "args": [
  "/models-ro",
  "--served-model-name",
  "__SERVED__",
  "Flash-Next-AWQ",
  "--dtype",
  "float16",
  "--enable-expert-parallel",
  "--block-size",
  "32",
  "--engram-config",
  "{\"cpu_offload\":true}",
  "--gdn-prefill-backend",
  "flashqla_sm75",
  "--host",
  "0.0.0.0",
  "--port",
  "8000",
  "--auto-sleep-idle-timeout",
  "0",
  "--tensor-parallel-size",
  "8",
  "--max-num-seqs",
  "8",
  "--max-num-batched-tokens",
  "2048",
  "--gpu-memory-utilization",
  "0.90",
  "--kv-cache-dtype",
  "fp8_e4m3",
  "--scheduler-cls",
  "vllm.v1.core.sched.scheduler_sm75.SM75Scheduler",
  "--enable-auto-tool-choice",
  "--tool-call-parser",
  "qwen3_coder",
  "--reasoning-parser",
  "qwen3",
  "--enable-prefix-caching",
  "--hf-overrides",
  "{\"dtype\":\"float16\",\"text_config\":{\"rope_parameters\":{\"mrope_interleaved\":true,\"mrope_section\":[11,11,10],\"partial_rotary_factor\":0.25,\"rope_theta\":10000000,\"rope_type\":\"default\"}}}",
  "--max-model-len",
  "262144",
  "--kv-cache-memory-bytes",
  "1879048192"
 ],
 "start": false,
 "binds": [],
 "lmcache": {
  "enabled": false,
  "cpuGiB": 64,
  "chunkSize": null,
  "diskPath": "",
  "minFreeDiskGiB": 4,
  "port": 5555,
  "httpPort": 5556
 }
}