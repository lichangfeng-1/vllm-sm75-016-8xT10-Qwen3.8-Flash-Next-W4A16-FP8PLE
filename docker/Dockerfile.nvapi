# syntax=docker/dockerfile:1.7
# 层 2：把 P-State 所需的 NVAPI 库烘进镜像（免挂载）
# 该库与宿主驱动 580.173.02 配套；换驱动需重新核对。
# 注意：镜像内 /bin/sh 是 dash，不支持 <<< here-string，校验一律走管道。
ARG BASE=vllm-sm75-next-ultra-0924:console-patched
FROM ${BASE}
LABEL sm75.nvapi.sha256="4a199f9b259a1098ab9c01d31c67f882a2531a0fbb9c3595ad3d016c7d131d8c" \
      sm75.nvapi.driver="580.173.02" \
      sm75.nvapi.source="redacted-private-host-path"
COPY libnvidia-api.so.1 /usr/local/nvidia/lib64/libnvidia-api.so.1
RUN echo "4a199f9b259a1098ab9c01d31c67f882a2531a0fbb9c3595ad3d016c7d131d8c  /usr/local/nvidia/lib64/libnvidia-api.so.1" | sha256sum -c -
