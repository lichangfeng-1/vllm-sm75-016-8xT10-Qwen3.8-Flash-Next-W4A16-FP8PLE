# syntax=docker/dockerfile:1.7
# 层 3：Qwen4Exp PLE/n-gram 嵌入对 compressed-tensors（AWQ int4）的支持补丁
# 目标模型：cyankiwi/Qwen3.8-Flash-Next-AWQ-INT4（仅名称+链接，权重不随包，使用者自行下载）
#   https://modelscope.cn/models/cyankiwi/Qwen3.8-Flash-Next-AWQ-INT4
# 不打本层则引擎启动报：
#   NotImplementedError: Qwen4Exp PLE embedding does not support quantization config CompressedTensorsConfig
# 构建内自检：patch 脚本断言锚点唯一 + py_compile + 回读分支，失败即构建失败（打印 PLE_AWQ_CONTRACT_OK）。
ARG BASE=vllm-sm75-next-ultra-0924:patched-nvapi
FROM ${BASE}
COPY patch_ple_awq.py /tmp/patch_ple_awq.py
RUN python3 /tmp/patch_ple_awq.py && rm -f /tmp/patch_ple_awq.py
