# syntax=docker/dockerfile:1.7
# 层 1：控制台 hardware() 的 GPU 查询超时 3s -> 20s
# 原因：8xT10 上 hardware.py 实测 6.9s（每卡多次 nvidia-smi），3s 预算恒超时，
#       导致控制台 gpu() 恒为空、启动引擎恒报「无法读取 GPU 状态」。
# 差异仅一行（原文件第 299 行），sha256 见 SHA256SUMS 与镜像 LABEL。
ARG BASE=vllm-sm75-next-ultra-0924:latest
FROM ${BASE}
LABEL sm75.patch.console_server_mjs="timeout 3000 -> 20000 (hardware.py exec)" \
      sm75.patch.console_server_mjs_sha256="4c2fb0602ab00a98a3bfeacbfe95e547d185bd91dd5486183df7a8e6910df6ea"
COPY console-server.mjs.patched /opt/sm75-workbench/console/server.mjs
RUN grep -n "timeout: 20000" /opt/sm75-workbench/console/server.mjs
