# syntax=docker/dockerfile:1.7
# 层 4（条件启用）：让 VLLM_MONITOR 可被 profile 的 env 覆盖
# 背景：config.mjs makeCommand 原写法 env={...p.env, VLLM_API_KEY, VLLM_MONITOR:'1'} 把 monitor 写在展开之后，
#       profile 无法关闭；实测怀疑（待 mtp5-nomonitor 格确认）monitor 插桩在 MTP 路径上造成 3-10 倍步时间税。
# 改法：VLLM_MONITOR 默认值放最前、...p.env 放后面 => profile env 设 VLLM_MONITOR=0 即关，默认仍为 1。
#       API key 仍强制注入（在展开之后），不受影响。
# 仅一行差异（第 74 行）：原件 sha256 5acdc5e73da6... / 补丁件 sha256 4fe3d04b429a...
# 启用条件：mtp5-nomonitor 格证实直起（无 monitor）MTP5 >= 60 tok/s 后再 build 本层
FROM vllm-sm75-next-ultra-0924:patched-nvapi
LABEL sm75.patch.config_mjs="VLLM_MONITOR overridable via profile env (default still 1)" \
      sm75.patch.config_mjs_sha256="4fe3d04b429a9742e16c0d2ad7df056f40bb00c07124d472c6f654d3ac95562c"
COPY console-config.mjs.monitorfix /opt/sm75-workbench/console/config.mjs
RUN grep -n "VLLM_MONITOR:'1',...p.env" /opt/sm75-workbench/console/config.mjs && \
    echo "4fe3d04b429a9742e16c0d2ad7df056f40bb00c07124d472c6f654d3ac95562c  /opt/sm75-workbench/console/config.mjs" | sha256sum -c -
