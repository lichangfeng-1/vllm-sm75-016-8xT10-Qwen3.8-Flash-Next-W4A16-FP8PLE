# 在 awqple 之上加 PLE 的 auto-round/INC 分支（Intel AutoRound W4A16 权重需要）。
# 基线：vllm-sm75 v0.1.6 派生镜像族；补丁＝ngram_embedding.incple-1938b4aa.py（953 行）。
ARG BASE=vllm-sm75-next-ultra-0924:patched-nvapi-awqple
FROM ${BASE}
COPY resolve_vllm_paths.py /tmp/resolve_vllm_paths.py
COPY ngram_embedding.incple-1938b4aa.py /tmp/ngram_embedding.incple.py
# 旧写法是 COPY 直接落到写死的 python3.12/dist-packages 路径：目录不存在时 Docker 会连目录一起造，
# 于是在不含 qwen4_exp 的基座上"构建成功"、产出一个没人 import 的孤儿文件（假通过）。
# 现在先解析并要求目标已在（层 3 的产物必然在），再覆盖，再跑原来三道断言。
RUN D=$(python3 /tmp/resolve_vllm_paths.py) \
 && cp /tmp/ngram_embedding.incple.py "$D" \
 && python3 -m py_compile "$D" \
 && test "$(grep -c INCConfig "$D")" = "1" \
 && test "$(wc -l < "$D")" = "953" \
 && rm -f /tmp/ngram_embedding.incple.py /tmp/resolve_vllm_paths.py \
 && echo "INCPLE_APPLIED $D"
LABEL sm75.nvapi.sha256=4a199f9b259a1098ab9c01d31c67f882a2531a0fbb9c3595ad3d016c7d131d8c \
      sm75.ple.patch=incple-1938b4aa \
      sm75.ple.supports="compressed-tensors,auto-round:auto_gptq,fp8"
