# 在 awqple 之上加 PLE 的 auto-round/INC 分支（Intel AutoRound W4A16 权重需要）。
# 基线：vllm-sm75 v0.1.6 派生镜像族；补丁＝ngram_embedding.incple-1938b4aa.py（953 行）。
ARG BASE=vllm-sm75-next-ultra-0924:patched-nvapi-awqple
FROM ${BASE}
COPY ngram_embedding.incple-1938b4aa.py /usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/ngram_embedding.py
RUN python3 -m py_compile /usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/ngram_embedding.py \
 && test "$(grep -c INCConfig /usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/ngram_embedding.py)" = "1" \
 && test "$(wc -l < /usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/ngram_embedding.py)" = "953"
LABEL sm75.nvapi.sha256=4a199f9b259a1098ab9c01d31c67f882a2531a0fbb9c3595ad3d016c7d131d8c \
      sm75.ple.patch=incple-1938b4aa \
      sm75.ple.supports="compressed-tensors,auto-round:auto_gptq,fp8"
